# 注意：TAG 的值需要跟随系统每次发布的 Git tag / 镜像版本一起更新。
# Kubernetes namespace 名称。
NAMESPACE=java-sql-web
# 当前部署使用的镜像版本标签。
TAG=v3.2.2
# JavaSqlWeb 服务端镜像地址。
JSW_SERVER_IMAGE=ghcr.io/guohai163/java-sql-web-server
# JavaSqlWeb 前端镜像地址。
JSW_FRONT_IMAGE=ghcr.io/guohai163/java-sql-web-front
# Vanna 问数服务镜像地址。
JSW_VANNA_IMAGE=ghcr.io/guohai163/java-sql-web-vanna
# JavaSqlWeb 主数据库名称。
DB_NAME=javasqlweb_db
# JavaSqlWeb 主数据库用户名。
DB_USERNAME=jsw
# JavaSqlWeb 主数据库密码。
DB_PASSWORD=my-secret-pw
# JavaSqlWeb 主数据库类型。
DB_DIALECT=postgresql
# JavaSqlWeb 主数据库端口。
DB_PORT=5432
# Kubernetes 中数据库使用的镜像。
DB_IMAGE=pgvector/pgvector:pg18
# 查询结果最大返回条数限制。
PROJECT_LIMIT=20000
# 系统内部签名 key。
PROJECT_SIGNKEY=jsw
# 对外访问域名。
PUBLIC_DOMAIN=jsw.example.com
# 对外访问完整地址，包含协议。
PUBLIC_HOST=https://jsw.example.com
# Ingress 绑定的域名。
INGRESS_HOST=jsw.example.com
# 数据库存储卷大小。
DB_STORAGE_SIZE=20Gi
# 存储类名称，留空表示使用集群默认 StorageClass。
DB_STORAGE_CLASS=
# 是否启用兼容老 MSSQL 的弱 TLS 配置。
PROJECT_LEGACY_TLS_ENABLED=false
# 传递给 Java 进程的额外 JVM 参数。
JAVA_TOOL_OPTIONS=
# Vanna HTTP 服务监听端口。
VANNA_PORT=8003
# Vanna 访问 jsw-server 内部上下文接口的地址。
JSW_SERVER_BASE_URL=http://jsw-server:8002
# jsw-server 与 jsw-vanna 间调用使用的内部令牌。
VANNA_INTERNAL_TOKEN=change-me
# Vanna 独立数据库完整连接串。
VANNA_DB_URL=postgresql://jsw_vanna:change-me@jsw-db:5432/jsw_vanna_db
# 生成 SQL 使用的聊天模型名称。
VANNA_CHAT_MODEL=gpt-5.4-mini
# embedding 模型来源，支持 huggingface / modelscope。
VANNA_EMBEDDING_MODEL_SOURCE=huggingface
# 本地 embedding 模型名称。
VANNA_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# ModelScope 模型仓库 ID，留空则回退到 VANNA_EMBEDDING_MODEL。
VANNA_EMBEDDING_MODELSCOPE_MODEL_ID=
# embedding 模型版本或分支名。
VANNA_EMBEDDING_MODEL_REVISION=
# embedding 模型本地缓存目录。
VANNA_EMBEDDING_MODEL_CACHE_DIR=
# 是否启用后台预热任务。
VANNA_WARMUP_ENABLED=true
# 服务启动后是否立即开始全量预热。
VANNA_WARMUP_ON_STARTUP=true
# 预热任务最大并发度，当前建议保持低并发。
VANNA_WARMUP_MAX_CONCURRENCY=1
# 夜间增量重建开始的小时数，24 小时制。
VANNA_WARMUP_NIGHTLY_HOUR=1
# 预热失败后下次允许重试的分钟数。
VANNA_WARMUP_RETRY_MINUTES=30
# OpenAI 兼容模型网关地址，通常写到 /v1。
VANNA_LLM_BASE_URL=https://api.openai.com/v1
# OpenAI 兼容模型调用密钥。
VANNA_LLM_API_KEY=
