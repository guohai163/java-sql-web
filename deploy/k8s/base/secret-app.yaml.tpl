apiVersion: v1
kind: Secret
metadata:
  name: jsw-app-secret
  namespace: ${NAMESPACE}
type: Opaque
stringData:
  DB_NAME: "${DB_NAME}"
  DB_USERNAME: "${DB_USERNAME}"
  DB_PASSWORD: "${DB_PASSWORD}"
  PROJECT_LIMIT: "${PROJECT_LIMIT}"
  PROJECT_SIGNKEY: "${PROJECT_SIGNKEY}"
  PROJECT_DOMAIN: "${PUBLIC_DOMAIN}"
  PROJECT_HOST: "${PUBLIC_HOST}"
  VANNA_INTERNAL_TOKEN: "${VANNA_INTERNAL_TOKEN}"
  VANNA_DB_URL: "${VANNA_DB_URL}"
  VANNA_CHAT_MODEL: "${VANNA_CHAT_MODEL}"
  VANNA_EMBEDDING_MODEL_SOURCE: "${VANNA_EMBEDDING_MODEL_SOURCE}"
  VANNA_EMBEDDING_MODEL: "${VANNA_EMBEDDING_MODEL}"
  VANNA_EMBEDDING_MODELSCOPE_MODEL_ID: "${VANNA_EMBEDDING_MODELSCOPE_MODEL_ID}"
  VANNA_EMBEDDING_MODEL_REVISION: "${VANNA_EMBEDDING_MODEL_REVISION}"
  VANNA_EMBEDDING_MODEL_CACHE_DIR: "${VANNA_EMBEDDING_MODEL_CACHE_DIR}"
  VANNA_WARMUP_ENABLED: "${VANNA_WARMUP_ENABLED}"
  VANNA_WARMUP_ON_STARTUP: "${VANNA_WARMUP_ON_STARTUP}"
  VANNA_WARMUP_MAX_CONCURRENCY: "${VANNA_WARMUP_MAX_CONCURRENCY}"
  VANNA_WARMUP_NIGHTLY_HOUR: "${VANNA_WARMUP_NIGHTLY_HOUR}"
  VANNA_WARMUP_RETRY_MINUTES: "${VANNA_WARMUP_RETRY_MINUTES}"
  VANNA_LLM_BASE_URL: "${VANNA_LLM_BASE_URL}"
  VANNA_LLM_API_KEY: "${VANNA_LLM_API_KEY}"
