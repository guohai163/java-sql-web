# 独立 GPU 主机上运行的 Vanna。不要提交填入实际密钥后的 .env。
TAG=v3.3.0

# 独立 GPU 主机自身的内网 IP；用它代替 K8s 内 jsw-vanna 服务名。
VANNA_BIND_IP=10.12.54.240
VANNA_PORT=8003

# 任选一个 K8s 节点的内网 IP。32002 是 service-server-vanna-nodeport.yaml 固定的 NodePort。
JSW_SERVER_BASE_URL=http://10.12.54.103:32002
VANNA_INTERNAL_TOKEN=replace-with-the-existing-vanna-internal-token

# Vanna 自己的缓存/审计 PG。先确认 10.12.54.239 的 BGP 路由已经生效。
VANNA_DB_URL=postgresql://jsw_vanna:replace-password@10.12.54.239:5432/jsw_vanna_db

VANNA_CHAT_MODEL=gpt-5.4-mini
VANNA_LLM_BASE_URL=https://api.openai.com/v1
VANNA_LLM_API_KEY=replace-with-the-existing-api-key

VANNA_EMBEDDING_MODEL_SOURCE=huggingface
VANNA_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
VANNA_EMBEDDING_MODELSCOPE_MODEL_ID=
VANNA_EMBEDDING_MODEL_REVISION=
VANNA_EMBEDDING_DEVICE=cuda:0

VANNA_WARMUP_ENABLED=true
VANNA_WARMUP_ON_STARTUP=true
VANNA_WARMUP_MAX_CONCURRENCY=1
VANNA_WARMUP_NIGHTLY_HOUR=1
VANNA_WARMUP_RETRY_MINUTES=30
